            "product": "fresh-escape-premium"
          }
        },
        "review_GPPnxQ": {
          "type": "review",
          "settings": {
            "content": "<p>\"Erg blij met dit merk. Prachtige geuren, net als het origineel maar voor minder geld. Ik koop zeker opnieuw.\"</p>",
