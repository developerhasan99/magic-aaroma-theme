    "massive_review_nBEgXq": {
      "type": "massive-review",
      "blocks": {
        "review_zMqL4P": {
          "type": "review",
          "settings": {
            "content": "<p>„Dit was mijn eerste bestelling hier en ik ben echt onder de indruk. Mijn parfum koop ik vanaf nu nergens anders meer. Ik had nog nooit een geur-dupe gevonden die echt authentiek ruikt en ook steeds even goed blijft.“</p>",
            "author": "Sven Jansen",
            "date": "1 dag geleden",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_7yim9e": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/magic_ugc_female_01.webp",
            "content": "<p>„Eerlijk, een van de beste geuren die ik in jaren heb geroken. De noten zijn gewoon waanzinnig goed. Deze blijft sowieso vast in mijn collectie.“</p>",
            "author": "Emma de Vries",
            "author_image": "shopify://shop_images/magic_ugc_female_01.webp",
            "date": "2 dagen geleden",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_8xigEg": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/image_1.jpg",
            "content": "<p>„Alle drie de geuren die ik heb besteld ruiken echt heel goed en blijven ook lang hangen. De geuren komen echt dicht bij de originelen. Het enige was de levertijd, die wat langer duurde. Maar heel eerlijk – ik heb toch meteen weer besteld 😄 Je moet gewoon een beetje geduld hebben.“</p>",
            "author": "Clara P.",
            "date": "2 dagen geleden",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_6QR3Gr": {
          "type": "review",
          "settings": {
            "content": "<p>„Ik heb eindeloos gezocht naar geuren die hoogwaardig ruiken en ook lang blijven hangen. Precies zo'n geur zocht ik.“</p>",
            "author": "Daan Visser",
            "date": "2 dagen geleden",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_iV6gep": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/magic_ugc_male_02.webp",
            "content": "<p>„Wist eerst niet goed wat ik kon verwachten, maar de geur heeft me echt positief verrast. Ruikt superfris en komt behoorlijk dicht bij Aventus. Blijft netjes hangen en de prijs is gewoon een stuk beter.“</p>",
            "author": "Michael T.",
            "author_image": "shopify://shop_images/magic_ugc_male_02.webp",
            "date": "2 dagen geleden",
            "rating": 4,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_GqfVXQ": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/magic_175_review.png",
            "content": "<p>„Een van mijn absolute favoriete geuren. Was supersnel bezorgd en ruikt gewoon echt lekker.“</p>",
            "author": "Jonas Hendriks",
            "date": "2 dagen geleden",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_ERC3KR": {
          "type": "review",
          "settings": {
            "content": "<p>„Mijn vriendin zei meteen dat ik lekker rook 😄 Sindsdien gebruik ik hem bijna elke dag.“</p>",
            "author": "Lukas Schneider",
            "date": "5 dagen geleden",
            "rating": 4,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_ymx9Ar": {
          "type": "review",
          "settings": {
            "content": "<p>„In het begin was ik wat bezorgd omdat de levering vertraagd was. Maar toen het parfum binnen was en de geur zich eenmaal had gezet – wauw, gewoon ongelofelijk goed.“</p>",
            "author": "Lionel M.",
            "date": "7 dagen geleden",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_bFmTKe": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/magic_ugc_male_01.webp",
