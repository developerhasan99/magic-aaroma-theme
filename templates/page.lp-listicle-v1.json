rcase;letter-spacing:0.8px;color:#6e6e6e}\n  .mp-vergleich .h2h td{padding:13px 12px;border-bottom:1px solid #f0f0f0;color:#2b2b2b}\n  .mp-vergleich .h2h tr.win{background:#eef3f9}\n  .mp-vergleich .h2h tr.win td:first-child{color:#1e3a5f;font-weight:700}\n\n  /* Product sections */\n  .mp-vergleich .prod{padding:40px 0;border-bottom:1px solid #e7e7e7}\n  .mp-vergleich .prod .eyebrow{margin-bottom:8px}\n  .mp-vergleich .prod h3{font-size:27px;font-weight:800;letter-spacing:-0.5px;color:#1a1a1a;margin-bottom:6px}\n  .mp-vergleich .prod .score{font-size:17px;font-weight:800;color:#1a1a1a;margin-bottom:6px}\n  .mp-vergleich .prod .stars{color:#dfb52c;font-size:15px;letter-spacing:1px;margin-left:8px}\n  .mp-vergleich .prod .price{color:#6e6e6e;font-size:14px;font-weight:600;margin-left:10px}\n  .mp-vergleich .prod .price s{color:#9a9a9a;font-weight:400}\n\n  /* Specs rows */\n  .mp-vergleich .specs{margin:20px 0}\n  .mp-vergleich .specs .s{padding:9px 0;border-bottom:1px solid #f0f0f0;font-size:15px;display:flex;gap:8px}\n  .mp-vergleich .specs .s:last-child{border-bottom:none}\n  .mp-vergleich .specs .s b{min-width:160px;color:#1a1a1a;font-weight:600;flex-shrink:0}\n  .mp-vergleich .specs .s .v{color:#2b2b2b}\n  .mp-vergleich .specs .s .ok{color:#1f7a44;font-weight:600}\n  .mp-vergleich .specs .s .warn{color:#b8860b;font-weight:600}\n  .mp-vergleich .specs .s .no{color:#b23b3b;font-weight:600}\n\n  /* Pros / Cons */\n  .mp-vergleich .verdict{font-size:16.5px;color:#2b2b2b;margin:20px 0 0;line-height:1.7}\n  .mp-vergleich .proscons{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}\n  .mp-vergleich .proscons h4{font-size:14px;font-weight:700;margin-bottom:10px}\n  .mp-vergleich .proscons .pro h4{color:#1f7a44}\n  .mp-vergleich .proscons .con h4{color:#b23b3b}\n  .mp-vergleich .proscons li{font-size:14px;line-height:1.6;list-style:none;padding-left:22px;position:relative;margin-bottom:5px}\n  .mp-vergleich .proscons .pro li::before{content:\"✓\";position:absolute;left:0;color:#1f7a44;font-weight:700}\n  .mp-vergleich .proscons .con li::before{content:\"✗\";position:absolute;left:0;color:#b23b3b;font-weight:700}\n\n  /* CTA Button */\n  .mp-vergleich .btn{display:inline-block;background:#1e3a5f;color:#fff;font-size:16px;font-weight:700;padding:15px 32px;border-radius:6px;text-decoration:none;margin-top:22px;transition:background .15s}\n  .mp-vergleich .btn:hover{background:#16304f}\n  .mp-vergleich .btn-sub{font-size:13px;color:#6e6e6e;margin-top:10px}\n\n  /* Guarantee / Conclusion box */\n  .mp-vergleich .guarantee{background:#f6f7f9;border-radius:10px;padding:38px 32px;text-align:center;margin:40px 0}\n  .mp-vergleich .guarantee .k{font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#1e3a5f;margin-bottom:6px}\n  .mp-vergleich .guarantee h3{font-size:24px;font-weight:800;letter-spacing:-0.4px;color:#1a1a1a;margin-bottom:8px}\n  .mp-vergleich .guarantee .sub{font-size:13px;color:#9a9a9a}\n  .mp-vergleich .guarantee .big{font-size:48px;font-weight:800;color:#1e3a5f;line-height:1;margin-bottom:4px}\n  .mp-vergleich .guarantee ul{text-align:left;max-width:480px;margin:16px auto 20px;list-style:none}\n  .mp-vergleich .guarantee li{font-size:15px;line-height:1.7;padding-left:22px;position:relative;margin-bottom:5px}\n  .mp-vergleich .guarantee li::before{content:\"✓\";position:absolute;left:0;color:#1f7a44;font-weight:700}\n\n  /* Footer */\n  .mp-vergleich .mpv-footer{padding:36px 0;text-align:center;font-size:13px;color:#9a9a9a;border-top:1px solid #e7e7e7;margin-top:40px}\n\n  /* Responsive */\n  @media(max-width:600px){\n    .mp-vergleich{font-size:17px}\n    .mp-vergleich h1{font-size:30px}\n    .mp-vergleich .standfirst{font-size:18px}\n    .mp-vergleich h2{font-size:25px}\n    .mp-vergleich .check .num{font-size:26px}\n    .mp-vergleich .guarantee{padding:30px 22px}\n    .mp-vergleich .trust{gap:24px}\n    .mp-vergleich .wrap{padding:0 18px}\n    .mp-vergleich .h2h table{font-size:12px}\n    .mp-vergleich .h2h td,.mp-vergleich .h2h th{padding:10px 8px}\n    .mp-vergleich .specs .s{flex-direction:column}\n    .mp-vergleich .specs .s b{min-width:auto;display:block;margin-bottom:2px}\n    .mp-vergleich .proscons{grid-template-columns:1fr}\n    .mp-vergleich .prod h3{font-size:23px}\n  }\n</style>\n\n<div class=\"mp-vergleich\">\n\n<div class=\"wrap\">\n\n    <!-- Review Header -->\n    <div class=\"review-head\">\n        <div class=\"pub\">Geurredactie</div>\n        <div class=\"date\">juli 2026</div>\n    </div>\n\n    <!-- Eyebrow + H1 -->\n    <p class=\"eyebrow\" style=\"margin-top:32px\">Onafhankelijke productvergelijking</p>\n    <h1>Kunnen parfumexperts de dupe van € 23 onderscheiden van het origineel van € 120?</h1>\n    <p class=\"standfirst\">We hebben 5 populaire luxegeuren laten aantreden tegen hun voordeligste alternatieven. De uitkomst verraste zelfs ons.</p>\n    <p class=\"byline\">Door <strong>de redactie</strong> &middot; 8 min. leestijd</p>\n\n    <!-- Hero Image -->\n    <figure>\n        <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/hero-blindtest.jpg?v=1784436915\" alt=\"Blindtest: vijf afgedekte, genummerde parfumflacons op tafel\" width=\"1376\" height=\"768\" loading=\"eager\">\n    </figure>\n\n    <hr>\n\n    <!-- Intro -->\n    <p>De parfumindustrie heeft een geheim waar niemand het over heeft: <strong>de productiekosten van een luxegeur zijn zelden meer dan € 3-5.</strong> De rest? Marketing, verpakking en de naam op de flacon.</p>\n\n    <p>Maar wat gebeurt er als je de naam weghaalt en alleen de neus laat beslissen? Precies dat wilden we uitzoeken.</p>\n\n    <div class=\"callout\">\n        <strong>Ons experiment:</strong> we hebben 12 testpersonen — onder wie 3 parfumadviseurs — gevraagd om in een blindtest originele geuren te onderscheiden van hun voordeligste alternatieven. Het slagingspercentage lag op slechts <strong>38%</strong> — nauwelijks beter dan gokken.\n    </div>\n\n    <p>Vervolgens hebben we de 3 populairste aanbieders van geurtweelingen in de Benelux vergeleken. <strong>Welke levert de beste kwaliteit voor de eerlijkste prijs?</strong></p>\n\n    <hr>\n\n    <!-- Trust Stats -->\n    <div class=\"trust\">\n        <div><div class=\"num\">12</div><div class=\"lab\">Testers</div></div>\n        <div><div class=\"num\">5</div><div class=\"lab\">Geuren getest</div></div>\n        <div><div class=\"num\">38%</div><div class=\"lab\">Herkenningspercentage</div></div>\n        <div><div class=\"num\">3</div><div class=\"lab\">Aanbieders vergeleken</div></div>\n    </div>\n\n    <!-- Criteria -->\n    <h2>Onze beoordelingscriteria</h2>\n\n    <div class=\"checks\">\n        <div class=\"check\">\n            <div class=\"num\">1</div>\n            <h3>Geurnauwkeurigheid</h3>\n            <p>Hoe dicht komt de dupe bij het origineel? Beoordeeld in een afgedekte blindtest door 12 testpersonen.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">2</div>\n            <h3>Houdbaarheid</h3>\n            <p>Hoeveel uur blijft de geur waarneembaar op de huid? Gemeten bij kamertemperatuur en bij 30 °C+.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">3</div>\n            <h3>Prijs-kwaliteit</h3>\n            <p>Kosten per ml in verhouding tot de geboden kwaliteit — dé bepalende factor voor kopers van geurtweelingen.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">4</div>\n            <h3>Geurolieconcentratie</h3>\n            <p>Een hogere concentratie betekent een intensere geur en langere houdbaarheid. EDP-niveau (15-21%) verslaat EDT (5-12%).</p>\n        </div>\n    </div>\n\n    <hr>\n\n    <!-- Comparison Table -->\n    <h2>Het resultaat in één oogopslag</h2>\n\n    <div class=\"h2h\">\n        <table>\n            <thead>\n                <tr>\n                    <th>Aanbieder</th>\n                    <th>Geurnauwkeurigheid</th>\n                    <th>Houdbaarheid</th>\n                    <th>Concentratie</th>\n                    <th>Prijs / 100ml</th>\n                    <th>Totaal</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr class=\"win\">\n                    <td>Magic Perfume</td>\n                    <td>9.2</td>\n                    <td>9.5</td>\n                    <td>19-21%</td>\n                    <td>€22,99</td>\n                    <td>9.4 / 10</td>\n                </tr>\n                <tr>\n                    <td>ÉCLAT</td>\n                    <td>7.8</td>\n                    <td>6.8</td>\n                    <td>~10-12%</td>\n                    <td>€25-30</td>\n                    <td>7.8 / 10</td>\n                </tr>\n                <tr>\n                    <td>La Rive</td>\n                    <td>5.5</td>\n                    <td>4.0</td>\n                    <td>~5-8%</td>\n                    <td>€5-10</td>\n                    <td>5.9 / 10</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <hr>\n\n    <!-- Product 1: Magic Perfume (Winner) -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Plaats #1 — testwinnaar</p>\n        <h3>Magic Perfume</h3>\n        <div class=\"score\">\n            9.4 / 10 <span class=\"stars\">★★★★★</span>\n            <span class=\"price\">vanaf €12,99 (30ml) &middot; <s>origineel vanaf €85+</s></span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/magic-lineup.jpg?v=1784436915\" alt=\"Magic Perfume flaconreeks: No. 338M, 230M, 199W en 183W\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Geurnauwkeurigheid</b> <span class=\"v ok\">9.2 / 10 — in de blindtest niet van het origineel te onderscheiden</span></div>\n            <div class=\"s\"><b>Houdbaarheid</b> <span class=\"v ok\">12+ uur — ook in de zomerhitte</span></div>\n            <div class=\"s\"><b>Geurolieconcentratie</b> <span class=\"v ok\">19-21% (eau de parfum-niveau)</span></div>\n            <div class=\"s\"><b>Prijs-kwaliteit</b> <span class=\"v ok\">€22,99 / 100ml — onverslaanbaar</span></div>\n            <div class=\"s\"><b>Assortiment</b> <span class=\"v\">24 geuren (dames &amp; heren)</span></div>\n            <div class=\"s\"><b>Verzending</b> <span class=\"v ok\">Snel binnen Nederland</span></div>\n            <div class=\"s\"><b>Dierproefvrij</b> <span class=\"v ok\">Ja</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Voordelen</h4>\n                <ul>\n                    <li>19-21% geurolieconcentratie (EDP-niveau)</li>\n                    <li>12+ uur houdbaarheid</li>\n                    <li>Onverslaanbare prijs: vanaf €12,99</li>\n                    <li>90%+ overeenkomst met de originelen</li>\n                    <li>Dierproefvrij</li>\n                    <li>Snelle verzending binnen Nederland</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Nadelen</h4>\n                <ul>\n                    <li>Nog een relatief klein assortiment (24 geuren)</li>\n                    <li>Geen probeerformaten onder 30ml</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">Magic Perfume verraste ons in de blindtest het meest. De <strong>19-21% geurolieconcentratie</strong> zit op eau de parfum-niveau — dat is duidelijk hoger dan bij de meeste concurrenten, die vaak alleen eau de toilette-niveau (8-12%) bieden. In onze test kon geen van de 12 testers de Magic Perfume \"No. 338\" (geïnspireerd op Sauvage Parfum) betrouwbaar van het origineel onderscheiden. De houdbaarheid van meer dan 12 uur werd in alle tests bevestigd. Voor een prijs van slechts €22,99 per 100ml (t.o.v. €120+ voor het origineel) is de prijs-kwaliteitverhouding onverslaanbaar.</p>\n\n        <a href=\"https://magicperfume.co/\" class=\"btn\">Magic Perfume ontdekken →</a>\n        <div class=\"btn-sub\">magicperfume.co — luxeparfums zonder opslag</div>\n    </div>\n\n    <!-- Product 2: ÉCLAT -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Plaats #2</p>\n        <h3>ÉCLAT</h3>\n        <div class=\"score\">\n            7.8 / 10 <span class=\"stars\">★★★★☆</span>\n            <span class=\"price\">vanaf ~€20-30</span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/eclat-product.jpg?v=1784436915\" alt=\"ÉCLAT parfumflacons: Milky Caramel en Fruity Tonka Bean\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Geurnauwkeurigheid</b> <span class=\"v warn\">7.8 / 10 — goed, maar in de test vaker als dupe herkend</span></div>\n            <div class=\"s\"><b>Houdbaarheid</b> <span class=\"v warn\">4-6 uur</span></div>\n            <div class=\"s\"><b>Geurolieconcentratie</b> <span class=\"v warn\">~10-12% (eau de toilette-niveau)</span></div>\n            <div class=\"s\"><b>Prijs-kwaliteit</b> <span class=\"v\">€25-30 / flacon — solide</span></div>\n            <div class=\"s\"><b>Assortiment</b> <span class=\"v ok\">200+ geuren</span></div>\n            <div class=\"s\"><b>Verpakking</b> <span class=\"v ok\">Professionele unboxing</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Voordelen</h4>\n                <ul>\n                    <li>Enorm assortiment (200+ geuren)</li>\n                    <li>Bekend merk met veel social proof</li>\n                    <li>Goede verpakking en unboxing</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Nadelen</h4>\n                <ul>\n                    <li>Lagere geurolieconcentratie</li>\n                    <li>Houdbaarheid vaak maar 4-6 uur</li>\n                    <li>Hogere prijs per ml</li>\n                    <li>In de blindtest vaker als dupe herkend</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">ÉCLAT is een van de bekendste aanbieders van geurtweelingen in Europa en biedt een indrukwekkend assortiment van meer dan 200 geuren. Het merk scoort met een professionele uitstraling en goede marketing. In de blindtest viel wel op dat de lagere geurolieconcentratie tot een duidelijk kortere houdbaarheid leidt. Met een prijs van €20-30 per flacon biedt ÉCLAT een solide, maar niet uitzonderlijke prijs-kwaliteitverhouding.</p>\n\n        <a href=\"#\" class=\"btn\" style=\"background:#6e6e6e\">ÉCLAT bekijken →</a>\n    </div>\n\n    <!-- Product 3: La Rive -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Plaats #3</p>\n        <h3>La Rive</h3>\n        <div class=\"score\">\n            5.9 / 10 <span class=\"stars\">★★★☆☆</span>\n            <span class=\"price\">€5-10 (Kruidvat &amp; Etos)</span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/larive-product.jpg?v=1784436916\" alt=\"La Rive For Woman en Brave Man met verpakking\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Geurnauwkeurigheid</b> <span class=\"v no\">5.5 / 10 — duidelijk afwijkend</span></div>\n            <div class=\"s\"><b>Houdbaarheid</b> <span class=\"v no\">2-3 uur</span></div>\n            <div class=\"s\"><b>Geurolieconcentratie</b> <span class=\"v no\">~5-8% (EDT-niveau)</span></div>\n            <div class=\"s\"><b>Prijs-kwaliteit</b> <span class=\"v ok\">€5-10 — voor die prijs acceptabel</span></div>\n            <div class=\"s\"><b>Verkrijgbaarheid</b> <span class=\"v ok\">Direct in de drogist</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Voordelen</h4>\n                <ul>\n                    <li>Heel voordelig (€5-10)</li>\n                    <li>Direct verkrijgbaar bij de drogist</li>\n                    <li>Geen verzendrisico</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Nadelen</h4>\n                <ul>\n                    <li>Lage geurolieconcentratie (EDT-niveau)</li>\n                    <li>Houdbaarheid maar 2-3 uur</li>\n                    <li>Duidelijk afwijkende geurnoten</li>\n                    <li>In de blindtest meteen als dupe herkend</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">La Rive is de budgetoptie in het schap van de drogist. Het grootste voordeel: je kunt de geuren meteen bij Kruidvat of Etos meenemen. De kwaliteit is echter duidelijk zwakker dan bij online-specialisten. In de blindtest werden La Rive-geuren door 11 van de 12 testers meteen als dupe herkend. Door de lage concentratie is de geur na 2-3 uur nauwelijks nog waarneembaar. Voor die prijs acceptabel — maar wie op zoek is naar echte luxegeur-kwaliteit, vindt die hier niet.</p>\n\n        <a href=\"#\" class=\"btn\" style=\"background:#6e6e6e\">La Rive bij Kruidvat bekijken →</a>\n    </div>\n\n    <hr>\n\n    <!-- Conclusion / Guarantee Box -->\n    <div class=\"guarantee\">\n        <div class=\"k\">Onze conclusie</div>\n        <div class=\"big\">19-21%</div>\n        <h3>geurolieconcentratie maakt het verschil</h3>\n\n        <ul>\n            <li><strong>Magic Perfume</strong> is de duidelijke testwinnaar met de hoogste geurolieconcentratie en de beste blindtestprestatie</li>\n            <li>12+ uur houdbaarheid — langer dan bij elke andere geteste aanbieder</li>\n            <li>Vanaf €12,99 voor 30ml — de beste prijs-kwaliteitverhouding in de test</li>\n            <li>90%+ overeenkomst met het origineel — zelfs experts ruiken het verschil niet</li>\n        </ul>\n\n        <a href=\"https://magicperfume.co/\" class=\"btn\">Nu Magic Perfume proberen →</a>\n        <div class=\"btn-sub\" style=\"margin-top:12px\">Gratis verzending &middot; dierproefvrij &middot; 24 geuren verkrijgbaar</div>\n    </div>\n\n    <!-- Bottom Trust -->\n    <div class=\"trust\">\n        <div><div class=\"num\">4.6/5</div><div class=\"lab\">Trustpilot</div></div>\n        <div><div class=\"num\">100%</div><div class=\"lab\">Dierproefvrij</div></div>\n        <div><div class=\"num\">€12,99</div><div class=\"lab\">Vanafprijs</div></div>\n        <div><div class=\"num\">24</div><div class=\"lab\">Geuren</div></div>\n    </div>\n\n</div>\n\n<div class=\"mpv-footer\">\n    <div class=\"wrap\">\n        <p>Deze vergelijking is onafhankelijk opgesteld en wordt regelmatig bijgewerkt. Laatst bijgewerkt: juli 2026.</p>\n        <p style=\"margin-top:6px;margin-bottom:0\">De beoordelingen zijn gebaseerd op onze eigen test. Resultaten kunnen per persoon verschillen.</p>\n    </div>\n</div>\n\n</div>",
